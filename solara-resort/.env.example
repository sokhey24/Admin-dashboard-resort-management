# Laravel API → Web_Resort_api/.env DB_DATABASE=resort_api (one shared MySQL database)
VITE_API_URL=http://localhost:8000/api

# Public storage URL for profile images and resort media (no trailing slash)
VITE_IMAGE_URL=http://localhost:8000/storage

# Activities page: set to true for local UI preview (sample cards + simulated booking, no API write).
# Set to false when CMS activities are published and POST /api/customer/activity-bookings should work.
# VITE_ACTIVITIES_FRONTEND_ONLY=true

# --- Access from another computer on the same network ---
# 1. On the host PC: php artisan serve --host=0.0.0.0 --port=8000  (in Web_Resort_api)
# 2. npm run dev in solara-resort (already binds 0.0.0.0:3000)
# 3. Set Web_Resort_api .env APP_URL=http://YOUR_LAN_IP:8000 (e.g. 192.168.0.248)
# 4. Open on another device: http://YOUR_LAN_IP:3000
# Optional: set VITE_API_URL / VITE_IMAGE_URL to http://YOUR_LAN_IP:8000/...
# If you keep localhost here, the app still uses YOUR_LAN_IP for API when opened via LAN URL.
